<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Информация об авторстве -->
    <Authors>Ваше имя или команда</Authors>
    <Company>Название компании</Company>
    <Product>A2V10.MCP</Product>
    <Description>Model Context Protocol server для A2V10</Description>
    <Copyright>Copyright © 2025</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- Информация о репозитории -->
    <RepositoryUrl>https://github.com/IgorAIvanov/A2V10.MCP</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/IgorAIvanov/A2V10.MCP</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="A2v10.ViewEngine.Xaml" Version="10.1.8622" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="ModelContextProtocol" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Tools\ModelScaffold\Resources\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Tools\ModelScaffold\Resources\AgentExample\agent.meta.json" />
    <None Remove="Tools\ModelScaffold\Resources\AgentExample\agent.sql" />
    <None Remove="Tools\ModelScaffold\Resources\AgentExample\browse.dialog.xaml" />
    <None Remove="Tools\ModelScaffold\Resources\AgentExample\edit.dialog.xaml" />
    <None Remove="Tools\ModelScaffold\Resources\AgentExample\edit.template.ts" />
    <None Remove="Tools\ModelScaffold\Resources\AgentExample\editfolder.dialog.xaml" />
    <None Remove="Tools\ModelScaffold\Resources\AgentExample\editfolder.template.ts" />
    <None Remove="Tools\ModelScaffold\Resources\AgentExample\index.template.ts" />
    <None Remove="Tools\ModelScaffold\Resources\AgentExample\index.view.xaml" />
    <None Remove="Tools\ModelScaffold\Resources\AgentExample\model.json" />
    <None Remove="Tools\ModelScaffold\Resources\AgentExample\show.template.ts" />
    <None Remove="Tools\ModelScaffold\Resources\AgentExample\show.view.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Tools\ModelScaffold\Resources\AgentExample\agent.meta.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\ModelScaffold\Resources\AgentExample\agent.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\ModelScaffold\Resources\AgentExample\browse.dialog.xaml">
      <Generator></Generator>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\ModelScaffold\Resources\AgentExample\edit.dialog.xaml">
      <Generator></Generator>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\ModelScaffold\Resources\AgentExample\edit.template.ts">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\ModelScaffold\Resources\AgentExample\editfolder.dialog.xaml">
      <Generator></Generator>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\ModelScaffold\Resources\AgentExample\editfolder.template.ts">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\ModelScaffold\Resources\AgentExample\index.template.ts">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\ModelScaffold\Resources\AgentExample\index.view.xaml">
      <Generator></Generator>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\ModelScaffold\Resources\AgentExample\model.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\ModelScaffold\Resources\AgentExample\show.template.ts">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\ModelScaffold\Resources\AgentExample\show.view.xaml">
      <Generator></Generator>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Completions\" />
    <Folder Include="Models\" />
    <Folder Include="Resources\XAML\" />
    <Folder Include="Resources\SQL\" />
    <Folder Include="Services\" />
    <Folder Include="Tests\" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include=".github\csharp-mcp-server.instructions.md" />
  </ItemGroup>

</Project>
